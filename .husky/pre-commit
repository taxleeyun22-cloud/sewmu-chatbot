#!/usr/bin/env sh
# Phase Infra-1 (2026-05-09): pre-commit hook
# - (중단 2026-11-11) 미러 자동 동기화 — apps/admin 동결
# - TypeScript type check (변경 코드 회귀 방지)
# - Vitest 단위 테스트 (전체, ~7초)
# 실패 시 commit 차단

# 0a. 모듈화 #1 (2026-05-18): admin-modals.html 은 modals/*.html 파티션의 생성물.
#     concat 빌드 후 stage (직접 수정 금지 — modals/ 만 편집). byte-identical 보장.
node scripts/build-modals.mjs
BM_RC=$?
if [ $BM_RC -ne 0 ]; then
  echo "❌ build-modals 실패. commit 차단."
  exit 1
fi
git add admin-modals.html modals/ 2>/dev/null || true

# 0b/0c. (중단 2026-11-11) apps/admin 미러 동기화 — 사장님 "Next.js 는 그냥 두고 기존 언어로 계속".
#    새 admin(sewmu-admin)은 청구서·영업타겟 전용 동결 스냅샷. root → apps/admin 복사 안 함.
#    되살리려면 사장님 확인 후 scripts/sync-mirror.mjs --stage, scripts/sync-assets.mjs 를 다시 넣는다.

# 1. Type check (전체)
npx tsc --noEmit
TSC_RC=$?
if [ $TSC_RC -ne 0 ]; then
  echo "❌ TypeScript type check 실패. commit 차단."
  exit 1
fi

# 2. Vitest 전체 (현재 ~7초)
npm test --silent
TEST_RC=$?
if [ $TEST_RC -ne 0 ]; then
  echo "❌ Vitest 단위 테스트 실패. commit 차단."
  exit 1
fi

echo "✅ pre-commit 검증 통과"
